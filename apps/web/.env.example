# =============================================================================
# apps/web — frontend (Next.js) environment template
# Copy to `apps/web/.env.local` and fill in real values. Never commit it.
# Only NEXT_PUBLIC_* vars are exposed to the browser — keep secrets out of here.
# =============================================================================

# Public base URL of the web app itself.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the backend API the browser/SSR calls.
NEXT_PUBLIC_API_URL=http://localhost:4000

# No payment publishable key is needed in the browser: PIX charges return a QR
# code + copia-e-cola string and crypto charges return an address, both minted
# server-side. Payment credentials live only in apps/api/.env.

# Default UI locale (Session 10) — the FINAL fallback in the resolution order
# NEXT_LOCALE cookie → Accept-Language header → this value. Must be one of the
# supported locales (pt-BR | en); anything else is ignored and pt-BR is used.
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR

# Origin that signed media URLs point at (Session 12) — the object-storage host
# behind STORAGE_ENDPOINT, e.g. https://your-project-ref.supabase.co. Added to
# the Content-Security-Policy's img-src/media-src so signed thumbnails and
# video URLs can load; nothing else from that host is allowed. Leave blank if
# media is only ever streamed through the API.
NEXT_PUBLIC_MEDIA_ORIGIN=

# ─── Build-time values (Session 13) ──────────────────────────────────────────
# Every NEXT_PUBLIC_* value above and below is INLINED INTO THE BUILD. In the
# Docker image they are build args (apps/web/Dockerfile): changing one means
# rebuilding the image, not editing a runtime env file. Never put a secret in
# a NEXT_PUBLIC_* variable — it ships to every browser.

# Sentry DSN for the web app. Unset = Sentry fully inert. Browser events go to
# our own /monitoring tunnel, which forwards to THIS DSN's project only.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Git SHA the image was built from (set by the deploy workflow).
NEXT_PUBLIC_SENTRY_RELEASE=
# Tracing sample rate 0–1. Default 0 (errors only).
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# CI only, optional — source-map upload to Sentry. Without SENTRY_AUTH_TOKEN no
# source maps are uploaded; browser source maps are never served either way.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT_WEB=
