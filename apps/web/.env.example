# =============================================================================
# apps/web — frontend (Next.js) environment template
# Copy to `apps/web/.env.local` and fill in real values. Never commit it.
# Only NEXT_PUBLIC_* vars are exposed to the browser — keep secrets out of here.
# =============================================================================

# Public base URL of the web app itself.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the backend API the browser/SSR calls.
NEXT_PUBLIC_API_URL=http://localhost:4000

# No payment publishable key is needed in the browser: PIX charges return a QR
# code + copia-e-cola string and crypto charges return an address, both minted
# server-side. Payment credentials live only in apps/api/.env.

# Default locale for the UI (pt-BR | en).
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
