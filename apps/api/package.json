{
  "name": "@creator-platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Creator Platform backend API (Fastify + Prisma).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "dependencies": {
    "@creator-platform/shared": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@prisma/client": "^5.18.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prisma": "^5.18.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
