# =============================================================================
# apps/api — backend (Fastify) environment template
# Copy to `apps/api/.env` and fill in real values. Never commit the `.env`.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase Postgres connection string (Project Settings > Database).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ─── Auth ────────────────────────────────────────────────────────────────────
# Random secret for signing JWT access tokens. Min 32 chars, enforced at boot.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
# Random secret for signing JWT refresh tokens. Min 32 chars, and it MUST differ
# from JWT_SECRET (boot fails if they are equal).
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Payments ────────────────────────────────────────────────────────────────
# Stripe is PERMANENTLY EXCLUDED from this project — it prohibits adult content.
# So are all Brazilian mainstream processors (PagBank, Pagar.me, Mercado Pago…).
# Never add keys for any of them here.
#
# Provider modes (Session 13). Every channel below — payments, payouts, AI,
# email — accepts a real adapter, `mock`, or `disabled`, and DEFAULTS TO
# `disabled` when unset (fail closed: checkout 503, webhook 404).
#   * `mock` is development/test only: NODE_ENV=production + `mock` on any
#     channel crashes at boot (mock webhooks verify against a public secret).
#   * A provider's credentials are required only while it is the active one.
#   * Unknown values crash at boot.
#
#   PAYMENT_PROVIDER_PIX     woovi | mock | disabled      (production: woovi, disabled)
#   PAYMENT_PROVIDER_CRYPTO  nowpayments | mock | disabled (production: nowpayments, disabled)
#   PAYMENT_PROVIDER_CARD    mock | disabled              (production: disabled until CCBill)
PAYMENT_PROVIDER_PIX=mock
PAYMENT_PROVIDER_CRYPTO=mock
PAYMENT_PROVIDER_CARD=mock

# Woovi (OpenPix) — PIX for the Brazilian market. Required only when
# PAYMENT_PROVIDER_PIX=woovi.
# App ID:         dashboard app.woovi.com > API/Plugins
# Webhook secret: dashboard app.woovi.com > Webhooks > create webhook
OPENPIX_APP_ID=your-openpix-app-id
OPENPIX_WEBHOOK_SECRET=your-openpix-webhook-secret
OPENPIX_API_URL=https://api.woovi.com

# NOWPayments — crypto (350+ coins incl. USDT/USDC). Required only when
# PAYMENT_PROVIDER_CRYPTO=nowpayments.
# API key:    https://nowpayments.io > Store Settings
# IPN secret: https://nowpayments.io > IPN Settings
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
NOWPAYMENTS_API_URL=https://api.nowpayments.io
# Optional recurring-plan ids (dashboard > Subscriptions). Leave blank to skip
# provider-side recurrence — the first period's payment is still created.
NOWPAYMENTS_PLAN_ID_STANDARD=
NOWPAYMENTS_PLAN_ID_PREMIUM=

# Public base URL the providers post webhooks back to (must be reachable from
# the internet — use an ngrok/cloudflared tunnel in local development).
API_PUBLIC_URL=http://localhost:4000

# ─── Payouts (Session 06) — money OUT, to models ─────────────────────────────
# paxum | mock | disabled (default disabled; production: paxum, disabled).
# Disabled: POST /api/payouts/run answers 503 payouts_disabled (after the
# secret check) and the Paxum IPN route does not exist.
PAYOUT_PROVIDER=mock

# Paxum — model payouts. Required only when PAYOUT_PROVIDER=paxum.
# API key / IPN secret: Paxum dashboard > Merchant Services > IPN Settings.
PAXUM_API_KEY=your-paxum-api-key
PAXUM_IPN_SECRET=your-paxum-ipn-secret
PAXUM_API_URL=https://api.paxum.com

# Shared secret for POST /api/payouts/run, which is called by the weekly
# GitHub Actions cron job (.github/workflows/weekly-payout.yml), not by a
# logged-in user. Generate with: openssl rand -hex 32
# Store the same value as a GitHub Actions repository secret. Required in
# production only while payouts are enabled.
PAYOUT_CRON_SECRET=change-me-to-a-long-random-string

# Model's cut of each confirmed subscription, whole percent (80/20 is the
# industry standard). Out-of-range values crash at boot rather than being
# clamped.
REVENUE_SHARE_MODEL_PCT=80

# Minimum payable balance in minor units (5000 = R$50). Below it, a model's
# balance simply rolls into the next week's run.
PAYOUT_MIN_THRESHOLD_CENTS=5000

# Currency Paxum settles payouts in.
PAYOUT_CURRENCY=BRL

# ─── Subscription lifecycle (Session 06.5) ───────────────────────────────────
# Shared secret for POST /api/subscriptions/renewals/run, called by the daily
# GitHub Actions cron job (.github/workflows/subscription-renewals.yml), not by
# a logged-in user. Generate with: openssl rand -hex 32
# Store the same value as a GitHub Actions repository secret.
SUBSCRIPTION_RENEWAL_CRON_SECRET=change-me-to-a-long-random-string

# How many days before a subscription's period ends the renewal charge is
# issued and the reminder email sent. PIX and crypto are one-shot instruments
# with no stored mandate, so the subscriber needs notice to pay.
SUBSCRIPTION_RENEWAL_REMINDER_DAYS=3

# How many days a non-payer stays PAST_DUE after their period ends before being
# marked EXPIRED. Their content access has already lapsed on its own by then.
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# ─── Storage (Supabase Storage or Cloudflare R2, S3-compatible) ──────────────
# Supabase: Project Settings > Storage > S3 Connection. Use the S3 endpoint
# (…/storage/v1/s3) and an S3 access key pair, NOT the project API keys.
STORAGE_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
STORAGE_BUCKET=reference-images
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
# Region only affects the SigV4 signature for region-less providers; leave as-is
# unless your provider requires a specific value (default: us-east-1).
STORAGE_REGION=us-east-1

# ─── AI Image Generation (Session 08) ────────────────────────────────────────
# replicate | mock | disabled (default disabled; production: replicate,
# disabled). `mock` returns a placeholder image with no token or network.
# Disabled: POST /api/generations answers 503 generation_unavailable before
# any credit is debited. With `replicate`, AI_PROVIDER_API_KEY is REQUIRED.
AI_PROVIDER=mock
# Token from https://replicate.com/account/api-tokens
AI_PROVIDER_API_KEY=r8_xxxxxxxxxxxxxxxxxxxxxxxx
# Wall-clock budget for one synchronous generation (create + poll + download).
# Past it the prediction is cancelled, the job is FAILED and credits refunded.
GENERATION_TIMEOUT_MS=90000
# Days a generated image stays servable before its `expiresAt` cuts it off.
GENERATION_IMAGE_RETENTION_DAYS=30

# ─── Anti-leak & content protection (Session 09) ─────────────────────────────
# HMAC key behind the per-viewer forensic trace code burned into every served
# image (and returned with every served video). REQUIRED in every environment,
# min 32 chars — boot fails otherwise. A code can only be resolved back to a
# viewer through the AuditLog, never from the code itself, as long as this stays
# secret. Generate with: openssl rand -hex 32
WATERMARK_TRACE_SECRET=change-me-to-a-long-random-string-min-32-chars
# Shared secret for POST /api/admin/storage/cleanup/run, called by the daily
# GitHub Actions cron job (.github/workflows/storage-cleanup.yml), not by a
# logged-in user. Generate with: openssl rand -hex 32
# Store the same value as a GitHub Actions repository secret.
STORAGE_CLEANUP_CRON_SECRET=change-me-to-a-long-random-string

# ─── Security hardening & reconciliation (Session 12) ────────────────────────
# Which proxies to trust for the client IP (X-Forwarded-For). Every IP-scoped
# rate limit (register, login, refresh, webhooks, cron runs) keys on it.
#   unset / false  → ignore X-Forwarded-For; the socket address is the client
#                    (correct when nothing sits in front of the API)
#   10.0.0.0/8,…   → trust only these proxy addresses/CIDRs
# `true` is REJECTED at boot (any client could spoof its IP), and so is a hop
# count like `1`: since fastify 5.12.5 a numeric value silently trusts NO proxy.
# Required in production. Behind the infra/compose.yaml Caddy this is the
# pinned compose subnet: TRUST_PROXY=172.30.0.0/24
TRUST_PROXY=
# Shared secret for POST /api/admin/reconciliation/run, called by the daily
# GitHub Actions cron job (.github/workflows/reconciliation.yml), not by a
# logged-in user. Generate with: openssl rand -hex 32
# Store the same value as a GitHub Actions repository secret.
RECONCILIATION_CRON_SECRET=change-me-to-a-long-random-string
# Age (ms) after which a PENDING generation is treated as abandoned by a crash:
# the sweep FAILs it and refunds its credits. Default 2 × GENERATION_TIMEOUT_MS;
# must be greater than GENERATION_TIMEOUT_MS (boot fails otherwise).
GENERATION_STALE_AFTER_MS=180000
# Hours after which a PENDING/PROCESSING payout with no IPN is flagged for a
# human (payout.stale_detected audit row, once per day). Never auto-resolved.
PAYOUT_STALE_AFTER_HOURS=72

# ─── Uploads (Session 13) ────────────────────────────────────────────────────
# Largest accepted upload (content + message attachments), in bytes. Uploads
# are buffered whole in memory (no streaming multipart yet), so this is sized
# to the API container: default 64 MiB; boot fails above 96 MiB (100663296).
# Caddy's request_body max_size (infra/Caddyfile) must stay this + a margin.
CONTENT_UPLOAD_MAX_BYTES=67108864

# ─── Email (Session 13) ──────────────────────────────────────────────────────
# resend | mock | disabled (default disabled). PRODUCTION ACCEPTS ONLY
# `disabled` for now: Resend's acceptable-use policy bars adult businesses, so
# `resend` is non-production only until a Mailgun/SES adapter exists.
#   disabled → POST /api/auth/register answers 503 registration_unavailable;
#              renewal reminders are skipped (counted, never sent).
#   mock     → nothing is sent; the verification link is logged (dev only).
EMAIL_PROVIDER=mock
# Resend key (https://resend.com/api-keys) — required only with EMAIL_PROVIDER=resend.
EMAIL_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ─── Server ──────────────────────────────────────────────────────────────────
# Port the Fastify server listens on.
API_PORT=4000
# Allowed CORS origin for browser requests (the web app URL).
APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Error monitoring (Session 13) ───────────────────────────────────────────
# Sentry DSN for the API. Unset = Sentry is fully inert (tests, local dev).
SENTRY_DSN=
# Environment tag on events (default: NODE_ENV).
SENTRY_ENVIRONMENT=
# Performance tracing sample rate, 0–1. Default 0 (errors only).
SENTRY_TRACES_SAMPLE_RATE=0
