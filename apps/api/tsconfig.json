{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../packages/shared/src/*"],
      "@api/*": ["./src/*"]
    }
  },
  // Emit is esbuild's job (build.mjs); tsc only typechecks (Session 13).
  "include": ["src/**/*.ts", "scripts/ops/**/*.ts", "scripts/check-watermark.ts"],
  "exclude": ["node_modules", "dist", "prisma/generated"]
}
