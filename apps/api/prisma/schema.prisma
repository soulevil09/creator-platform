// =============================================================================
// Prisma schema — Creator Platform
//
// Database: PostgreSQL on Supabase (managed free tier, no credit card needed).
// ORM:      Prisma — TypeScript-first, generated type-safe client, first-class
//           migrations, and an easy path to swap the DB provider later.
//
// Session 02 introduces the first domain model: User (auth + RBAC).
// Session 03 adds model onboarding: ModelProfile (profile data, ToS + AI
// likeness consent) and ReferenceImage (uploaded likeness references stored in
// Supabase Storage; only the object key is persisted, signed URLs are minted
// on demand and never written to the DB).
// Session 04 adds the content lifecycle: Content (monetizable media stored
// behind short-lived signed URLs / on-the-fly watermarking — only the object
// key is persisted, never exposed) and ContentAccess (per-user access grants,
// the join that gates tier-based viewing; populated by Session 05's payment
// webhooks).
// Session 05 adds the payments domain: Subscription, CreditWallet,
// PaymentTransaction (idempotency-keyed) and AuditLog.
// Session 06 adds revenue sharing and payouts (plus `ModelProfile.payoutEmail`,
// the Paxum destination address): the model/platform split is
// stamped onto each confirmed SUBSCRIPTION transaction, and Payout records one
// weekly Paxum transfer. A model's payable balance is never a stored counter —
// it is derived as SUM(modelShareCents) WHERE payoutId IS NULL, so the ledger
// is the single source of truth and cannot drift from a cached total.
// Session 06.5 adds the subscription lifecycle: `Subscription.cancelAtPeriodEnd`
// separates "will this renew" from `status` ("what access is live right now"),
// so a daily sweep can issue renewal charges, open a grace period for
// non-payers, and land opted-out subscribers on CANCELED rather than EXPIRED.
// Session 07 adds private messaging: Conversation (one per subscriber/model
// pair, mirroring Subscription's own pair uniqueness) and Message (text and/or
// a single image/video attachment). Attachment object keys are persisted but
// NEVER serialized — the same rule Content.storageKey and
// ReferenceImage.storageKey already follow.
// Session 08 adds AI image personalization: GenerationJob records one credit
// spend → one generated image of one consenting model. `modelId` is required
// on every row precisely so a future session can extend revenue sharing to
// credit spend without a data migration. The hidden likeness-anchor prompt is
// never persisted; `userPrompt` holds only the subscriber-supplied text.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // Generated client lives under prisma/generated/ (gitignored), keeping the
  // committed tree free of generated code.
  output   = "generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── RBAC roles ──────────────────────────────────────────────────────────────
// ADMIN is provisioned out-of-band (never via public registration).
enum Role {
  ADMIN
  MODEL
  SUBSCRIBER
}

// ─── User ────────────────────────────────────────────────────────────────────
// Auth identity + RBAC. Passwords are bcrypt hashes (cost 12); the refresh
// token is persisted only as a bcrypt hash (cost 10) so a DB leak can't replay
// sessions. The email verification token is a one-time random value (not a
// secret key) and is stored in plain text with a 24h expiry.
model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  passwordHash         String
  role                 Role            @default(SUBSCRIBER)
  displayName          String
  isVerified           Boolean         @default(false)
  verifyToken          String?         @unique
  verifyTokenExpiresAt DateTime?
  refreshTokenHash     String?
  modelProfile         ModelProfile?
  uploadedContent      Content[]
  contentAccesses      ContentAccess[]

  // Payments (Session 05)
  creditWallet        CreditWallet?
  paymentTransactions PaymentTransaction[]
  subscriptions       Subscription[]       @relation("SubscriberSubscriptions")
  subscribers         Subscription[]       @relation("ModelSubscribers")
  auditLogs           AuditLog[]

  // Payouts (Session 06) — money out, to a MODEL's Paxum wallet.
  payouts Payout[] @relation("ModelPayouts")

  // Messaging (Session 07) — 1:1 conversations, from both sides of the pair.
  subscriberConversations Conversation[] @relation("SubscriberConversations")
  modelConversations      Conversation[] @relation("ModelConversations")
  sentMessages            Message[]      @relation("SentMessages")

  // AI generation (Session 08) — jobs a subscriber requested, and jobs that
  // used a model's likeness.
  generationRequests  GenerationJob[] @relation("SubscriberGenerations")
  likenessGenerations GenerationJob[] @relation("ModelGenerations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── ModelProfile ────────────────────────────────────────────────────────────
// One-to-one with a MODEL User. Holds public profile data plus the two consent
// timestamps that gate AI usage: `tosAcceptedAt` (must be set before consent)
// and `aiConsentAt` (when the model granted likeness usage). Deleting the User
// cascades the profile (and its reference images) away.
model ModelProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  bio         String?
  country     String // ISO 3166-1 alpha-2, e.g. "BR"
  currency    String  @default("USD") // "USD" | "BRL" | "EUR"

  aiConsent     Boolean   @default(false)
  aiConsentAt   DateTime?
  tosAcceptedAt DateTime?

  // ─── Payout destination (Session 06 addendum) ─────────────────────────────
  // Where Paxum sends this model's earnings. Deliberately NOT `User.email`:
  // Paxum pays into a personal Paxum account, whose email need not match the
  // platform login. UNIQUE because two models pointing at one Paxum address
  // would misroute funds — the database refuses that outright rather than
  // trusting an application-layer check. Null until the model sets it, which
  // makes them skipped (never failed) by a payout run.
  payoutEmail String? @unique

  referenceImages ReferenceImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── ReferenceImage ──────────────────────────────────────────────────────────
// A likeness reference uploaded by a model. Only the Storage object key is
// persisted; the signed URL is ephemeral (minted on demand, short TTL) and is
// never stored. Capped at 10 per profile, enforced at the service layer.
model ReferenceImage {
  id             String       @id @default(cuid())
  modelProfileId String
  modelProfile   ModelProfile @relation(fields: [modelProfileId], references: [id], onDelete: Cascade)

  storageKey String // Supabase Storage object key (path)
  signedUrl  String? // ephemeral; not persisted — generated on-demand
  mimeType   String
  sizeBytes  Int

  createdAt DateTime @default(now())
}

// ─── Content (Session 04) ────────────────────────────────────────────────────
// Monetizable media uploaded by a MODEL. Only the Storage object key is
// persisted — it is NEVER returned to a client. Media is delivered exclusively
// via short-lived signed URLs (thumbnails) or on-the-fly watermarked byte
// streams (the /serve endpoint), never a public/permanent URL. Soft-deleted via
// `deletedAt` (a cleanup job removes the underlying object later, out of scope).
enum ContentType {
  IMAGE
  VIDEO
}

// Visibility tier. FREE is a public teaser; STANDARD requires any active
// subscription; PREMIUM requires an active PREMIUM subscription. Single-item
// (pay-per-view) purchase is out of product scope — see CLAUDE.md.
enum ContentTier {
  FREE
  STANDARD
  PREMIUM
}

model Content {
  id           String      @id @default(cuid())
  modelId      String
  model        User        @relation(fields: [modelId], references: [id])
  title        String
  description  String?
  type         ContentType
  tier         ContentTier @default(STANDARD)
  storageKey   String // S3 key, never exposed externally
  mimeType     String
  sizeBytes    Int
  width        Int? // pixels, images only
  height       Int? // pixels, images only
  durationSecs Int? // seconds, videos only (null at MVP — no ffprobe)
  isPublished  Boolean     @default(false)
  viewCount    Int         @default(0)
  deletedAt    DateTime? // soft-delete tombstone; storage cleanup deferred
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  accesses ContentAccess[]

  @@index([modelId])
  @@index([tier])
  @@index([isPublished])
}

// ─── ContentAccess (Session 04) ──────────────────────────────────────────────
// A per-user grant to view one Content item. `grantReason` records why access
// was granted; `expiresAt` is null for permanent grants (owner/admin) and set
// for subscription-derived access (recalculated on renewal). The /serve and
// list endpoints check `expiresAt` server-side on every request. Session 05's
// Woovi/NOWPayments webhook handler is the main writer (via grantContentAccess).
model ContentAccess {
  id          String    @id @default(cuid())
  contentId   String
  content     Content   @relation(fields: [contentId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  grantReason String // 'subscription_standard' | 'subscription_premium' | 'model_owner' | 'admin'
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime? // null = permanent (owner/admin); set for subscription-based

  @@unique([contentId, userId])
  @@index([userId])
  @@index([contentId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Payments domain (Session 05)
//
// Provider-agnostic by design: every row records which provider produced it
// (`PaymentProvider`), but no provider-specific column exists — swapping an
// adapter never requires a migration. Money is stored in **minor units**
// (centavos/cents) as integers; floats never touch a balance.
// ═══════════════════════════════════════════════════════════════════════════

/// Payment channel providers. CCBILL_MOCK is the deferred card slot, served by
/// MockPaymentProvider until CCBill is activated post-MVP.
enum PaymentProvider {
  WOOVI
  NOWPAYMENTS
  CCBILL_MOCK
}

enum PaymentTransactionType {
  SUBSCRIPTION
  CREDIT_PACK
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
}

// ─── Subscription ────────────────────────────────────────────────────────────
// A subscriber's recurring access to one model's tier. One row per
// (subscriber, model) pair — renewals push `currentPeriodEnd` forward and a
// tier change updates the same row rather than creating a second one.
model Subscription {
  id           String @id @default(cuid())
  subscriberId String
  subscriber   User   @relation("SubscriberSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  modelId      String
  model        User   @relation("ModelSubscribers", fields: [modelId], references: [id], onDelete: Cascade)

  tier                   ContentTier // STANDARD | PREMIUM (FREE is never sold)
  status                 SubscriptionStatus @default(ACTIVE)
  provider               PaymentProvider
  providerSubscriptionId String? // provider-side recurrence handle (null until the provider registers one)
  currentPeriodEnd       DateTime

  // ─── Lifecycle (Session 06.5) ─────────────────────────────────────────────
  // "Will this renew", kept separate from `status` ("what access do they have
  // right now") rather than added as a fifth status value. A subscriber who
  // cancels keeps exactly what they paid for: they stay ACTIVE with
  // `cancelAtPeriodEnd: true`, the renewal sweep issues them no charge, and at
  // `currentPeriodEnd` they go straight to CANCELED — never PAST_DUE, since
  // there is nothing to retry for someone who opted out. A lapsed non-payer
  // (`cancelAtPeriodEnd: false`) walks ACTIVE → PAST_DUE → EXPIRED instead, so
  // churn and payment failure stay distinguishable in reporting.
  cancelAtPeriodEnd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriberId, modelId])
  @@index([modelId])
  @@index([status])
  // The renewal sweep's four passes all filter on exactly these three columns.
  @@index([status, cancelAtPeriodEnd, currentPeriodEnd])
}

// ─── CreditWallet ────────────────────────────────────────────────────────────
// Internal currency, one wallet per user. `balance` is a whole number of
// credits and must never go negative — enforced by a CHECK constraint in the
// migration plus a conditional decrement (`balance >= amount`) in the service,
// so an under-funded debit updates zero rows instead of mutating partially.
model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── PaymentTransaction ──────────────────────────────────────────────────────
// One financial intent. Created PENDING at checkout, flipped to CONFIRMED (or
// FAILED) by the provider webhook.
//
// `idempotencyKey` is generated locally at checkout and handed to the provider
// as its correlation/order id, so the webhook echoes it back. The UNIQUE index
// on it is the source of truth for webhook idempotency: confirmation is a
// conditional update (`WHERE idempotencyKey = ? AND status = 'PENDING'`), so a
// replayed delivery matches zero rows and cannot double-credit.
model PaymentTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type                  PaymentTransactionType
  provider              PaymentProvider
  providerTransactionId String? // filled in when the webhook confirms
  idempotencyKey        String                 @unique

  amount         Int // minor units (centavos/cents)
  currency       String // "BRL" | "USD" | "EUR"
  creditsGranted Int? // CREDIT_PACK only

  // SUBSCRIPTION only — which model/tier this charge buys.
  modelId String?
  tier    ContentTier?

  // ─── Revenue share (Session 06) ───────────────────────────────────────────
  // Stamped when a SUBSCRIPTION webhook confirms, from REVENUE_SHARE_MODEL_PCT.
  // Remainder-to-platform rounding (`platform = amount - model`) so no cent is
  // ever lost or invented. Null on CREDIT_PACK rows: credits are a wallet-wide
  // balance with no per-model attribution until AI generation ships (Session
  // 08), so there is nothing honest to split here yet.
  modelShareCents    Int?
  platformShareCents Int?

  // Set when a payout run claims this row; null means "still payable". The
  // claim is a conditional update (`WHERE payoutId IS NULL`), so two concurrent
  // runs cannot both include the same earnings.
  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  status      PaymentStatus @default(PENDING)
  confirmedAt DateTime?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([providerTransactionId])
  // The balance derivation (`WHERE modelId = ? AND payoutId IS NULL`) runs on
  // every balance read and once per model per payout run.
  @@index([modelId, payoutId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Payouts domain (Session 06)
//
// Money out: the platform's weekly transfer of each model's revenue share to
// their Paxum wallet. Provider-agnostic in the same way the payments domain is
// — the row records which adapter produced it, but no Paxum-specific column
// exists, so swapping IPayoutProvider implementations needs no migration.
// ═══════════════════════════════════════════════════════════════════════════

/// Payout adapter identities. PAXUM_MOCK is the deterministic offline
/// stand-in (`PAYOUT_PROVIDER=mock`), mirroring CCBILL_MOCK on the payments
/// side.
enum PayoutProvider {
  PAXUM
  PAXUM_MOCK
}

/// PENDING    — created and funded locally, not yet handed to the provider
/// PROCESSING — the provider accepted the batch; awaiting its IPN
/// COMPLETED  — the provider confirmed the money landed
/// FAILED     — rejected; the included transactions were released back to the
///              unpaid pool (payoutId reset to null) for the next run
enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Payout ──────────────────────────────────────────────────────────────────
// One weekly transfer to one model. `amountCents` is not a free-standing
// number: it always equals the sum of `modelShareCents` over the
// PaymentTransaction rows pointing at this payout, which is what makes the
// ledger auditable. `idempotencyKey` is minted locally and handed to the
// provider as its correlation id, so the IPN echoes it back — the same round
// trip that makes payment webhooks idempotent (Session 05).
model Payout {
  id      String @id @default(cuid())
  modelId String
  model   User   @relation("ModelPayouts", fields: [modelId], references: [id], onDelete: Cascade)

  amountCents      Int
  currency         String // "BRL" | "USD" | "EUR"
  status           PayoutStatus   @default(PENDING)
  provider         PayoutProvider
  providerPayoutId String? // filled in when the provider accepts the batch
  idempotencyKey   String         @unique

  // Window of earnings this payout settles (informational: membership is
  // decided by the payoutId stamp, not by a date range).
  periodStart DateTime
  periodEnd   DateTime

  failureReason String? // provider-supplied; never contains a credential

  transactions PaymentTransaction[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([modelId])
  @@index([status])
  @@index([createdAt])
}

// ─── AuditLog ────────────────────────────────────────────────────────────────
// Append-only trail for every state-changing financial operation. `actorId` is
// null for system/provider-triggered events (webhooks), which is why the
// relation is optional and set null on user deletion — the trail outlives the
// account.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String // e.g. "payment.charge_created", "wallet.credited"
  entity    String // e.g. "PaymentTransaction", "CreditWallet"
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// Messaging domain (Session 07)
//
// 1:1 private chat between one subscriber and one model. Group chats are out
// of product scope, which is why `Conversation` names its two participants as
// columns rather than carrying a participants join table: the pair IS the
// conversation, and `@@unique([subscriberId, modelId])` makes that a database
// guarantee rather than an application convention — the same shape
// `Subscription` already uses for the same pair.
//
// Who may write is deliberately NOT stored here. A subscriber's right to send
// is `Subscription.status === 'ACTIVE'`, read live on every send: caching it
// onto the conversation at creation time would keep a lapsed subscriber
// writing forever. History, by contrast, is never retroactively hidden —
// messages already paid for stay readable to both parties whatever the
// subscription does afterwards.
// ═══════════════════════════════════════════════════════════════════════════

/// Media kinds a message may carry. Deliberately its own enum rather than a
/// reuse of `ContentType`: chat attachments and the monetized content library
/// are different products with different caps, and widening one enum later
/// must not silently widen the other.
enum MessageAttachmentType {
  IMAGE
  VIDEO
}

// ─── Conversation ────────────────────────────────────────────────────────────
// `lastMessageAt` is denormalized from the newest Message purely so the
// conversation list can be ordered and paged without touching the messages
// table — it is written in the same transaction as the message that sets it.
// Null until the first message is sent (a conversation can exist empty, since
// creating one and writing to it are separate calls).
model Conversation {
  id           String @id @default(cuid())
  subscriberId String
  subscriber   User   @relation("SubscriberConversations", fields: [subscriberId], references: [id], onDelete: Cascade)
  modelId      String
  model        User   @relation("ModelConversations", fields: [modelId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime?

  messages Message[]

  createdAt DateTime @default(now())

  @@unique([subscriberId, modelId])
  // Both sides read their own inbox ordered by recency; each participant gets
  // the index that makes that one query, not a scan.
  @@index([modelId, lastMessageAt])
  @@index([subscriberId, lastMessageAt])
}

// ─── Message ─────────────────────────────────────────────────────────────────
// Text, one attachment, or both — never neither. "Never neither" is a CHECK
// constraint written by hand in the migration (Prisma has no CHECK primitive),
// for the same reason the payments domain puts its invariants there: an
// application-level guard is one code path away from being bypassed.
//
// `attachmentStorageKey` is persisted but NEVER serialized to a client. The
// only way to reach the bytes is GET /api/messages/attachments/:messageId,
// which checks participation and mints a 60-second signed URL — identical
// discipline to `Content.storageKey`.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  /// Null when the message is attachment-only.
  body String?

  attachmentType       MessageAttachmentType?
  attachmentStorageKey String? // S3 key, never exposed externally
  attachmentMimeType   String?
  attachmentSizeBytes  Int?

  /// Set when the *other* participant opens the conversation. Null = unread.
  readAt DateTime?

  createdAt DateTime @default(now())

  // Serves both the cursor-paginated history read (conversationId + createdAt
  // DESC) and the unread-count groupBy, which filters the same leading column.
  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ═══════════════════════════════════════════════════════════════════════════
// AI generation domain (Session 08)
//
// One `GenerationJob` per credit spend: a subscriber asks for a personalized
// image of one consenting model, credits are debited, the provider is called
// synchronously, and the row ends COMPLETED (image stored, expiry set) or
// FAILED (credits refunded in the same transaction that records the failure).
//
// What is deliberately NOT here: the likeness-anchor prompt. It is assembled
// per request from the model's profile + reference images, handed to the
// provider, and discarded — never a column, never a log line, never a
// response field. `userPrompt` carries only what the subscriber typed (or a
// preset's human-readable label), so the audit trail records intent without
// recording the platform's own prompt engineering.
// ═══════════════════════════════════════════════════════════════════════════

enum GenerationMode {
  PRESET
  CUSTOM
}

/// PENDING   — credits debited, provider call in flight (one per subscriber
///             at a time; enforced by a partial unique index in the migration)
/// COMPLETED — image stored; `storageKey` + `expiresAt` set
/// FAILED    — provider/storage failure; credits refunded, `errorMessage` set
enum GenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

// ─── GenerationJob ───────────────────────────────────────────────────────────
// `modelId` is required, not nullable: it is the attribution a future
// credit-spend revenue share depends on (CLAUDE.md Open Items), and a job with
// no model is not a job this platform can produce. `storageKey` follows the
// Content / Message rule — persisted, never serialized; the only way to the
// bytes is GET /api/generations/:id/image, which watermarks on the fly.
model GenerationJob {
  id           String @id @default(cuid())
  subscriberId String
  subscriber   User   @relation("SubscriberGenerations", fields: [subscriberId], references: [id], onDelete: Cascade)
  modelId      String
  model        User   @relation("ModelGenerations", fields: [modelId], references: [id], onDelete: Cascade)

  mode       GenerationMode
  presetId   String? // PRESET only — catalog id from @creator-platform/shared
  /// Subscriber-supplied text (CUSTOM) or the preset's label (PRESET).
  /// NEVER the resolved anchor prompt.
  userPrompt String?

  creditsCost Int
  status      GenerationStatus @default(PENDING)

  storageKey    String? // S3 key, set on COMPLETED, never exposed externally
  providerJobId String? // provider-side prediction id, audit/debug only
  errorMessage  String? // FAILED only — short internal code, never the raw provider payload
  expiresAt     DateTime? // COMPLETED only — image is unservable past this

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Gallery listing, newest first, scoped to the caller.
  @@index([subscriberId, createdAt])
  // Future revenue-share query path (unused today; cheap now vs. a migration later).
  @@index([modelId])
}
