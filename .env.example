# =============================================================================
# Creator Platform — root environment template
# Copy to `.env` and fill in real values. NEVER commit a filled-in `.env`.
# Apps also have their own scoped `.env.example` (apps/api, apps/web).
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase Postgres connection string.
# Supabase dashboard > Project Settings > Database > Connection string (URI).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ─── Auth ────────────────────────────────────────────────────────────────────
# Random secret for signing JWT access tokens (min 32 chars).
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
# Random secret for signing JWT refresh tokens (min 32 chars, different value).
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Payments ────────────────────────────────────────────────────────────────
# Stripe is PERMANENTLY EXCLUDED from this project — it prohibits adult content.
# So are all Brazilian mainstream processors (PagBank, Pagar.me, Mercado Pago…).
# Never add keys for any of them here.
#
# Which adapter serves each channel. `mock` is a valid offline/dev value for pix
# and crypto (no credentials needed, no network); `card` accepts `mock` ONLY
# until CCBill is activated post-MVP. Any other value crashes at boot.
PAYMENT_PROVIDER_PIX=woovi
PAYMENT_PROVIDER_CRYPTO=nowpayments
PAYMENT_PROVIDER_CARD=mock

# Woovi (OpenPix) — PIX for the Brazilian market.
# App ID:         dashboard app.woovi.com > API/Plugins
# Webhook secret: dashboard app.woovi.com > Webhooks > create webhook
OPENPIX_APP_ID=your-openpix-app-id
OPENPIX_WEBHOOK_SECRET=your-openpix-webhook-secret
OPENPIX_API_URL=https://api.woovi.com

# NOWPayments — crypto (350+ coins incl. USDT/USDC).
# API key:    https://nowpayments.io > Store Settings
# IPN secret: https://nowpayments.io > IPN Settings
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
NOWPAYMENTS_API_URL=https://api.nowpayments.io
# Optional recurring-plan ids (dashboard > Subscriptions). Leave blank to skip
# provider-side recurrence — the first period's payment is still created.
NOWPAYMENTS_PLAN_ID_STANDARD=
NOWPAYMENTS_PLAN_ID_PREMIUM=

# Public base URL the providers post webhooks back to (must be reachable from
# the internet — use an ngrok/cloudflared tunnel in local development).
API_PUBLIC_URL=http://localhost:4000

# ─── Payouts (Session 06) — money OUT, to models ─────────────────────────────
# Which adapter sends payouts. `mock` is a valid offline/dev value (no
# credentials, no network); any other value crashes at boot.
PAYOUT_PROVIDER=paxum

# Paxum — model payouts. Business account + mass payout API access required.
# API key / IPN secret: Paxum dashboard > Merchant Services > IPN Settings.
PAXUM_API_KEY=your-paxum-api-key
PAXUM_IPN_SECRET=your-paxum-ipn-secret
PAXUM_API_URL=https://api.paxum.com

# Shared secret for POST /api/payouts/run, which is called by the weekly
# GitHub Actions cron job (.github/workflows/weekly-payout.yml), not by a
# logged-in user. Generate with: openssl rand -hex 32
# Store the same value as a GitHub Actions repository secret.
PAYOUT_CRON_SECRET=change-me-to-a-long-random-string

# Model's cut of each confirmed subscription, whole percent (80/20 is the
# industry standard). Out-of-range values crash at boot rather than being
# clamped.
REVENUE_SHARE_MODEL_PCT=80

# Minimum payable balance in minor units (5000 = R$50). Below it, a model's
# balance simply rolls into the next week's run.
PAYOUT_MIN_THRESHOLD_CENTS=5000

# Currency Paxum settles payouts in.
PAYOUT_CURRENCY=BRL

# ─── Storage (Supabase Storage or Cloudflare R2) ─────────────────────────────
STORAGE_ENDPOINT=https://your-project-ref.supabase.co/storage/v1
STORAGE_BUCKET=creator-platform
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key

# ─── AI Image Generation (Replicate) ─────────────────────────────────────────
# Token from https://replicate.com/account/api-tokens
AI_PROVIDER_API_KEY=r8_xxxxxxxxxxxxxxxxxxxxxxxx
AI_PROVIDER=replicate

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Key from https://resend.com/api-keys
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NODE_ENV=development
