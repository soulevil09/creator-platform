# =============================================================================
# Creator Platform — root environment template
# Copy to `.env` and fill in real values. NEVER commit a filled-in `.env`.
# Apps also have their own scoped `.env.example` (apps/api, apps/web).
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase Postgres connection string.
# Supabase dashboard > Project Settings > Database > Connection string (URI).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ─── Auth ────────────────────────────────────────────────────────────────────
# Random secret for signing JWT access tokens (min 32 chars).
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
# Random secret for signing JWT refresh tokens (min 32 chars, different value).
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Signing secret from https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Storage (Supabase Storage or Cloudflare R2) ─────────────────────────────
STORAGE_ENDPOINT=https://your-project-ref.supabase.co/storage/v1
STORAGE_BUCKET=creator-platform
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key

# ─── AI Image Generation (Replicate) ─────────────────────────────────────────
# Token from https://replicate.com/account/api-tokens
AI_PROVIDER_API_KEY=r8_xxxxxxxxxxxxxxxxxxxxxxxx
AI_PROVIDER=replicate

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Key from https://resend.com/api-keys
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NODE_ENV=development
